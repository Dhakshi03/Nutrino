# ==========================================================
# NUTRINO — Environment Configuration (.env.example)
# Copy this file to .env.local and fill in optional cloud keys.
# Nutrino works out-of-the-box with its local persistent SQL/JSON
# database and deterministic Indian Food NLP + Nutrition Engine!
# ==========================================================

# 1. Supabase Configuration (Optional - falls back to local persistent DB if unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. AI Provider Keys (Optional - server-side only, never exposed to client)
# Supports Google Gemini (text + vision) or OpenAI
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
AI_PROVIDER=gemini

# 3. Application Session Secret
NUTRINO_SESSION_SECRET=nutrino-local-dev-secret-change-in-production

